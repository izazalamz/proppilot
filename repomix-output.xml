            description: 'Open plan office with meeting rooms',
        },
    });

    // 9. Create Units
    console.log('🚪 Creating units...');
    const unit101 = await prisma.unit.create({
        data: {
            propertyId: property1.id,
            unitGroupId: floor1.id,
